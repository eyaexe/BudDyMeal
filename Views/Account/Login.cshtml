@model BudDyMeal.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login - BudDy Meal";
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow border-0 rounded-4 p-4">
        <h2 class="text-center fw-bold text-primary mb-1">BudDy Meal</h2>
        <p class="text-center text-muted mb-4">PUP Lagoon Budget Meal Finder</p>

        <!-- Dual Portal Switcher -->
        <div class="btn-group w-100 mb-4" role="group">
            <a asp-action="Login" asp-route-type="Student"
               class="btn @(Model.LoginType == "Student" ? "btn-primary" : "btn-outline-primary")">
                Login as Student
            </a>
            <a asp-action="Login" asp-route-type="StallOwner"
               class="btn @(Model.LoginType == "StallOwner" ? "btn-primary" : "btn-outline-primary")">
                Login as Stall Owner
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2 small">@TempData["Success"]</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small">
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>
        }

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="LoginType" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Email</label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                Sign In as @(Model.LoginType == "Student" ? "Student" : "Stall Owner")
            </button>
        </form>

        <div class="text-center mt-3">
            <small class="text-muted">Don't have an account?
                <a asp-action="Register" asp-route-type="@Model.LoginType">Register as @Model.LoginType</a>
            </small>
        </div>
    </div>
</div>